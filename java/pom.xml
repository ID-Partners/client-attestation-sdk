<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>global.idpartners</groupId>
    <artifactId>client-attestation-sdk</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>client-attestation-sdk</name>
    <description>Client-side builder SDK for OAuth Attestation-Based Client Authentication
        (draft-ietf-oauth-attestation-based-client-auth): mints the Client Attestation JWT (attester side)
        and the PoP / DPoP proofs plus request headers (client side). Built on jose4j.</description>
    <url>https://github.com/ID-Partners/client-attestation-sdk</url>

    <organization>
        <name>ID Partners Pty Ltd</name>
        <url>https://idpartners.global</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>ID Partners Pty Ltd</name>
            <organization>ID Partners Pty Ltd</organization>
            <organizationUrl>https://idpartners.global</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/ID-Partners/client-attestation-sdk</url>
        <connection>scm:git:https://github.com/ID-Partners/client-attestation-sdk.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ID-Partners/client-attestation-sdk.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/ID-Partners/client-attestation-sdk/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId><version>0.9.7</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.0</version></plugin>
            <!-- -sources and -javadoc jars, required for Maven Central -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <quiet>true</quiet>
                    <!-- every doclint check except "missing" (an undocumented getter, say) fails the build -->
                    <doclint>all,-missing</doclint>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution><id>prepare-agent</id><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
                    <!-- floors are today's measured coverage without the interop profile; raise them, never lower -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.91</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.88</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Maven Central release: `mvn -P release deploy`, run by .github/workflows/release.yml. Signs every
          artifact with GPG and uploads the bundle through the Sonatype Central Portal, which validates it,
          publishes it and waits until it is live. Needs a `central` server (a Central Portal user token) in
          settings.xml and a GPG secret key whose passphrase is in MAVEN_GPG_PASSPHRASE. Plain `mvn verify`
          never touches any of this. `mvn -P release -Dgpg.skip verify` builds everything a release
          uploads (jar, -sources, -javadoc, pom), unsigned.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <!-- no TTY in CI: gpg takes the passphrase from MAVEN_GPG_PASSPHRASE, never prompts -->
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <deploymentName>${project.artifactId} ${project.version}</deploymentName>
                            <!-- publish as soon as validation passes (no manual click in the portal), and
                                 fail the build unless the release is actually live -->
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                            <waitMaxTime>3600</waitMaxTime>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          Round-trips what the SDK builds against the AS-side verifier (client-attestation), which is not on
          Maven Central. `mvn verify -Pinterop` where that jar is installed locally; plain `mvn verify` from a
          clean clone runs everything else.
        -->
        <profile>
            <id>interop</id>
            <dependencies>
                <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>client-attestation</artifactId><version>0.1.0</version><scope>test</scope></dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <id>add-interop-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration><sources><source>src/interop-test/java</source></sources></configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- GitHub Packages, for a plain `mvn deploy`. The `release` profile deploys to Maven Central instead. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/ID-Partners/client-attestation-sdk</url>
        </repository>
    </distributionManagement>
</project>
