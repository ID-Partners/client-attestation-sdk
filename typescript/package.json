{
  "name": "@idpartners/client-attestation-sdk",
  "version": "1.0.0",
  "description": "Client-side builder SDK for OAuth Attestation-Based Client Authentication",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:edge": "node test/edge/run-workerd.mjs",
    "emit": "tsx emit.ts",
    "validate-emit": "tsx validate-emit.ts"
  },
  "license": "Apache-2.0",
  "author": "ID Partners Pty Ltd",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ID-Partners/client-attestation-sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/ID-Partners/client-attestation-sdk/tree/main/typescript",
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "workerd": "1.20261007.1"
  }
}
