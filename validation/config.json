        "introspection_client_id": null
      }
    },
    {
      "name": "introspection_client_secret_empty",
      "expect": "refused",
      "config": {
        "introspection_endpoint": "https://issuer.example.com/introspect",
        "introspection_client_secret": ""
      }
    },
    {
      "name": "introspection_client_secret_null",
      "expect": "refused",
      "config": {
        "introspection_endpoint": "https://issuer.example.com/introspect",
        "introspection_client_secret": null
